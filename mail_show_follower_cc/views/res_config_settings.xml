<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.mail.show.follower</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="emails" position="inside">
                <setting help="Add internal users in cc mails details">
                    <field name="show_internal_users_cc" />
                </setting>
                <setting
                    title="CC Blocked Models"
                    help="Do not show CC when emails are sent from the following models"
                >
                    <field name="cc_blocked_models" widget="many2many_tags" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
