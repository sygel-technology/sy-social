<odoo>
    <data noupdate="1">
        <template
            id="mail_notification_confirm_hide_button"
            inherit_id="mail.mail_notification_light"
        >
            <xpath expr="//t[@t-if='has_button_access']" position="after">
                <t
                    t-set="hidden_button_models"
                    t-value="record.env['ir.model'].get_hidden_mail_portal_access_models()"
                />
                <t
                    t-set="should_hide_button"
                    t-value="record._name in hidden_button_models"
                />
            </xpath>
            <xpath expr="//t[@t-if='has_button_access']" position="attributes">
                <attribute
                    name="t-if"
                >has_button_access and not should_hide_button</attribute>
            </xpath>
        </template>
    </data>
</odoo>
