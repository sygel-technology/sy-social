<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.mail.show.follower</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="emails" position="inside">
                <setting class="col-12 col-lg-6">
                    <field name="show_internal_users_cc" />
                    <div class="text-muted" id="show_internal_users_cc">
                        Add internal users in cc mails details
                    </div>
                </setting>
                <setting class="col-12 col-lg-6">
                    <span class="o_form_label">CC Blocked Models</span>
                    <span
                        class="fa fa-lg fa-building-o"
                        title="CC Blocked Models"
                        aria-label="Values set here are company-specific."
                        groups="base.group_multi_company"
                    />
                    <div class="text-muted">
                        Do not show CC when emails are sent from the following models
                    </div>
                    <div class="content-group">
                        <div class="mt16 row">
                            <label
                                for="cc_blocked_models"
                                string="Models"
                                class="col-3 col-lg-3 o_light_label"
                            />
                            <field
                                name="cc_blocked_models"
                                class="oe_inline"
                                widget="many2many_tags"
                            />
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
